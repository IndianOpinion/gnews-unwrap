<?xml version="1.0"?>
<ruleset name="gnews-unwrap">
    <description>PSR-12 for gnews-unwrap.</description>
    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/>

    <file>src</file>
    <file>tests</file>
    <file>examples</file>
    <file>bootstrap.php</file>

    <rule ref="PSR12">
        <!-- bootstrap.php registers an autoloader and declares nothing; that is its job. -->
        <exclude name="PSR1.Files.SideEffects.FoundWithSymbols"/>
    </rule>
    <rule ref="Generic.Files.LineLength">
        <properties>
            <property name="lineLimit" value="160"/>
            <property name="absoluteLineLimit" value="200"/>
        </properties>
    </rule>
</ruleset>
